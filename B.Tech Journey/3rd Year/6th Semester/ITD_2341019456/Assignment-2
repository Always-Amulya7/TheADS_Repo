-- a) Display structure of all tables

DESC BRANCH;
DESC CUSTOMER;
DESC ACCOUNT;
DESC LOAN;
DESC TRANSACTION_DETAILS;

-- b) Display contents of all tables

SELECT * FROM BRANCH;
SELECT * FROM CUSTOMER;
SELECT * FROM ACCOUNT;
SELECT * FROM LOAN;
SELECT * FROM TRANSACTION_DETAILS;

-- c) Customer number and branch code of each account holder

SELECT CUST_NO, BRANCH_CODE FROM ACCOUNT;

-- d) Customer number and balance of Savings accounts

SELECT CUST_NO, BALANCE 
FROM ACCOUNT 
WHERE ACC_TYPE = 'Savings';

-- e) Account number and transaction ID for deposits > 5000

SELECT ACC_NO, TRANS_ID 
FROM TRANSACTION_DETAILS 
WHERE TRANS_TYPE = 'Deposit' AND TRANS_AMOUNT > 5000;

-- f) Customers whose loan amount < 200000

SELECT * 
FROM LOAN 
WHERE AMOUNT < 200000;

-- g) Customer numbers who do NOT have Savings accounts

SELECT DISTINCT CUST_NO 
FROM ACCOUNT 
WHERE CUST_NO NOT IN (
    SELECT CUST_NO FROM ACCOUNT WHERE ACC_TYPE = 'Savings'
);

-- h) Distinct cities in branch table

SELECT DISTINCT CITY FROM BRANCH;

-- i) Account numbers with transactions in January 2025

SELECT DISTINCT ACC_NO 
FROM TRANSACTION_DETAILS
WHERE TRANS_DATE BETWEEN DATE '2025-01-01' AND DATE '2025-01-31';

-- j) Account numbers whose balance is not equal to 32000

SELECT ACC_NO 
FROM ACCOUNT 
WHERE BALANCE <> 32000;

-- k) All account details sorted by balance (descending)

SELECT * 
FROM ACCOUNT 
ORDER BY BALANCE DESC;

