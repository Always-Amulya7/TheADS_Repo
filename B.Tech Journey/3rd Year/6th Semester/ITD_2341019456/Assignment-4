-- 1. DEPARTMENT
CREATE TABLE DEPARTMENT (
    DEPT_NAME VARCHAR(50) PRIMARY KEY,
    BUILDING VARCHAR(50) NOT NULL,
    BUDGET DECIMAL(10,2) CHECK (BUDGET > 0)
);

-- 2. INSTRUCTOR
CREATE TABLE INSTRUCTOR (
    ID CHAR(5) PRIMARY KEY,
    NAME VARCHAR(50) NOT NULL,
    DEPT_NAME VARCHAR(50),
    SALARY DECIMAL(10,2) CHECK (SALARY > 2000),
    FOREIGN KEY (DEPT_NAME) REFERENCES DEPARTMENT(DEPT_NAME)
);

-- 3. STUDENT
CREATE TABLE STUDENT (
    ID CHAR(5) PRIMARY KEY,
    NAME VARCHAR(50) NOT NULL,
    DEPT_NAME VARCHAR(50),
    TOT_CRED INT CHECK (TOT_CRED >= 0),
    FOREIGN KEY (DEPT_NAME) REFERENCES DEPARTMENT(DEPT_NAME)
);

-- 4. CLASSROOM
CREATE TABLE CLASSROOM (
    ROOM_NO INT,
    BUILDING VARCHAR(50),
    CAPACITY INT CHECK (CAPACITY >= 10),
    PRIMARY KEY (ROOM_NO, BUILDING)
);

-- 5. COURSE
CREATE TABLE COURSE (
    COURSE_ID VARCHAR(10) PRIMARY KEY,
    TITLE VARCHAR(100) NOT NULL,
    DEPT_NAME VARCHAR(50),
    CREDIT INT CHECK (CREDIT > 0),
    FOREIGN KEY (DEPT_NAME) REFERENCES DEPARTMENT(DEPT_NAME)
);

-- 6. SECTION
CREATE TABLE SECTION (
    COURSE_ID VARCHAR(10),
    SEC_ID VARCHAR(10),
    SEMESTER VARCHAR(10),
    YEAR INT CHECK (YEAR BETWEEN 2000 AND 2026),
    ROOM_NO INT,
    BUILDING VARCHAR(50),
    PRIMARY KEY (COURSE_ID, SEC_ID, SEMESTER, YEAR),
    FOREIGN KEY (COURSE_ID) REFERENCES COURSE(COURSE_ID),
    FOREIGN KEY (ROOM_NO, BUILDING) REFERENCES CLASSROOM(ROOM_NO, BUILDING),
    CHECK (SEMESTER IN ('SPRING','SUMMER','FALL','WINTER'))
);

-- 7. ADVISOR
CREATE TABLE ADVISOR (
    I_ID CHAR(5),
    S_ID CHAR(5),
    PRIMARY KEY (I_ID, S_ID),
    FOREIGN KEY (I_ID) REFERENCES INSTRUCTOR(ID),
    FOREIGN KEY (S_ID) REFERENCES STUDENT(ID)
);

-- 8. TEACHES
CREATE TABLE TEACHES (
    ID CHAR(5),
    COURSE_ID VARCHAR(10),
    SEC_ID VARCHAR(10),
    SEMESTER VARCHAR(10),
    YEAR INT,
    PRIMARY KEY (ID, COURSE_ID, SEC_ID, SEMESTER, YEAR),
    FOREIGN KEY (ID) REFERENCES INSTRUCTOR(ID),
    FOREIGN KEY (COURSE_ID, SEC_ID, SEMESTER, YEAR)
        REFERENCES SECTION(COURSE_ID, SEC_ID, SEMESTER, YEAR)
);

-- 9. TAKES
CREATE TABLE TAKES (
    S_ID CHAR(5),
    COURSE_ID VARCHAR(10),
    SEC_ID VARCHAR(10),
    SEMESTER VARCHAR(10),
    YEAR INT,
    GRADE VARCHAR(2),
    PRIMARY KEY (S_ID, COURSE_ID, SEC_ID, SEMESTER, YEAR),
    FOREIGN KEY (S_ID) REFERENCES STUDENT(ID),
    FOREIGN KEY (COURSE_ID, SEC_ID, SEMESTER, YEAR)
        REFERENCES SECTION(COURSE_ID, SEC_ID, SEMESTER, YEAR)
);

