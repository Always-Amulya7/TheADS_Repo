package Quiz_Workspace.Quiz_Work;

public class Work {
	private int Start,Stop;

	public int getStart(){
		return Start;
	}

	public void setStart(int Start){
		this. Start = Start;
	}

	public int getStop(){
		return Stop;
	}

	public void setStop(int Stop){
		this. Stop = Stop;
	}

	public Work(int start, int stop) {
		super();
		Start = start;
		Stop = stop;
	}

	public Work() {
		super();
		// TODO Auto-generated constructor stub
	}

	@Override
	public String toString() {
		return "Work [Start=" + Start + ", Stop=" + Stop + "]";
	}
}